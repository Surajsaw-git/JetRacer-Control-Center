# JetRacer Control Center — Backend Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# Never commit real passwords, secret tokens, or private LAN IPs to version control.

# Application Identity & Mode
APP_NAME="JetRacer Control Center Backend"
APP_VERSION="0.2.1"
ENVIRONMENT="development"
DEBUG=false

# Network Binding
# 127.0.0.1 limits connections to local loopback (default for security).
# Change to 0.0.0.0 only when hosting over the local robot Wi-Fi network.
HOST="127.0.0.1"
PORT=8000

# CORS Allowed Origins (Comma-separated)
# In production, wildcard '*' is rejected by configuration validation.
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost,capacitor://localhost"

# Storage Directories & Database URL
DATA_DIR="./data"
LOG_DIR="./logs"
DATABASE_URL="sqlite:///./data/jetracer.db"

# Logging Configuration
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_FORMAT: text (human-readable) | json (structured JSON-lines)
LOG_LEVEL="INFO"
LOG_FORMAT="text"
LOG_TO_FILE=false

# WebSocket Management & Backpressure Limits
WS_HEARTBEAT_INTERVAL_S=15.0
WS_HEARTBEAT_TIMEOUT_S=30.0
WS_MAX_CONNECTIONS=10
WS_MAX_MESSAGE_BYTES=65536
WS_SEND_QUEUE_SIZE=100

# Future Phase Placeholders
# ROSBRIDGE_URL: Set in Phase 4 once inspected on the robot (e.g. ws://127.0.0.1:9090)
# ROSBRIDGE_URL=
# AUTH_ENABLED: Enabled in Phase 13 for token-based local security
AUTH_ENABLED=false
# SECRET_KEY: Set to high-entropy random string in Phase 13
# SECRET_KEY=
