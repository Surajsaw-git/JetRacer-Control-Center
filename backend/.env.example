# JetRacer Control Center Backend Environment Variables Example
PROJECT_NAME="JetRacer Control Center Backend"
VERSION="0.1.0"
ENVIRONMENT="development"

HOST="0.0.0.0"
PORT=8000

# Comma-separated list or JSON array of allowed origins for CORS
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost,capacitor://localhost"

# Database URL: SQLite (default) or PostgreSQL (e.g. postgresql+psycopg2://user:pass@localhost:5432/jetracer)
DATABASE_URL="sqlite:///./data/jetracer.db"
