# Auto detect text files and perform LF normalization
* text=auto

# Source code files - ensure LF line endings across Windows and Linux
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.py text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.launch text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.service text eol=lf
*.toml text eol=lf
